# atWork / SSHJ terminal isolation.
#
# Enforces that any terminal in this directory ONLY sees SSHJ credentials,
# with all foreign-tenant (Stadium Agency, ScottDudley1 personal) config
# blocked. Runs on `cd` when direnv is enabled, or via `source .envrc`.
#
# Also usable in scripts:  `source .envrc && bq ls ...`

# Isolated gcloud config — blocks default ~/.config/gcloud/ (Stadium Agency).
export CLOUDSDK_CONFIG="$PWD/.gcloud"

# Explicit atWork/SSHJ identifiers.
export GCP_PROJECT_ID="dashboard-1-sshj-internal"
export SUPABASE_PROJECT_REF="krbveactwladtwiqrmts"
export VERCEL_ORG_ID="team_YaPC3yG9kmyV1Q65UHdDlqMe"
export VERCEL_PROJECT_ID="prj_Dh6zyAO6dC1l0jbTKtMSFpBOjKKK"

# Block any inherited foreign credential env vars.
unset GOOGLE_APPLICATION_CREDENTIALS
unset GCLOUD_PROJECT
unset CLOUDSDK_ACTIVE_CONFIG_NAME

# Load .env.local so runtime secrets are available to scripts.
if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
fi

# Sanity print — comment out for silence if noisy.
: "atWork/SSHJ shell — CLOUDSDK_CONFIG=$CLOUDSDK_CONFIG"
